# SPDX-License-Identifier: LGPL-3.0-only
#
# Environment for the containerised API. Copy to ops/erp.env (git-ignored) and
# edit. Nothing here is a secret placeholder that works: the values below are the
# documented defaults or explicit operator decisions, never credentials.

# --- Durable paths (inside the container; both volumes must be mounted) ------
ERP_DB_PATH=/var/lib/erp/erp.sqlite3
ERP_VAULT_PATH=/var/lib/erp/vault
ERP_SECURITY_LOG_PATH=/var/log/erp/security.jsonl

# --- Listener ---------------------------------------------------------------
# 0.0.0.0 is correct *inside* a container; the published port is bound to
# 127.0.0.1 by docker-compose so the proxy is the only way in.
ERP_HOST=0.0.0.0
ERP_PORT=8000
ERP_LOG_LEVEL=info

# --- Authentication ---------------------------------------------------------
# Session lifetime in seconds (8 hours).
ERP_TOKEN_TTL_SECONDS=28800
# Failed-login throttle: attempts per (client address, account) inside the
# window, checked before the password is verified.
ERP_AUTH_FAILURE_LIMIT=10
ERP_AUTH_FAILURE_WINDOW_SECONDS=300
# Aggregate failures per client across ALL usernames in the same window. This is
# the bound that survives username flooding: without it, varying the username
# would give an attacker a fresh per-account budget each time. 0 disables it.
ERP_AUTH_CLIENT_FAILURE_LIMIT=50
# Hard cap on tracked buckets per limiter. Past it, the least-recently-touched
# bucket is evicted, so memory cannot grow with attacker-chosen usernames.
ERP_AUTH_FAILURE_MAX_KEYS=4096
# Where the counters live:
#   memory (default) = per process. One replica, or the ceiling is N x the limit.
#   sqlite           = shared by every process that opens this database file,
#                      i.e. `uvicorn --workers N` or several containers on one
#                      volume. It is NOT a distributed bound across separate
#                      databases, and it puts rate-limit rows in the ledger
#                      database (pruned every second, capped at 200k rows).
ERP_RATE_LIMIT_BACKEND=memory
# What to do when a shared backend cannot be consulted:
#   fail_closed (default) = refuse the attempt. An unavailable counter must not
#                           become an unlimited guessing window.
#   fail_open             = allow the attempt and log RATE_LIMIT_BACKEND_UNAVAILABLE.
# Either way the event is logged; the choice is recorded here, not assumed.
ERP_RATE_LIMIT_FAILURE_MODE=fail_closed
# Optional overall per-client request ceiling per minute (0 = disabled). Set it
# only if the proxy in front cannot do it better.
ERP_RATE_LIMIT_PER_MINUTE=0

# --- Reverse proxy ----------------------------------------------------------
# Fail-closed: no entry means X-Forwarded-For is ignored entirely. Set this to
# the proxy's CIDR(s) if and only if every request really arrives through it.
# ERP_TRUSTED_PROXIES=10.0.0.0/8,127.0.0.1

# --- API documentation ------------------------------------------------------
# /docs, /redoc and /openapi.json are 404 unless this is true. Keep false in
# staging and production.
ERP_DOCS_ENABLED=false

# --- Keys -------------------------------------------------------------------
# Leave unset for the file-backed provider (keys live on the vault volume).
# Setting kms or hsm makes start-up refuse rather than mislabel file keys.
# ERP_KEY_PROVIDER=file

# --- Uploads ----------------------------------------------------------------
# ERP_MAX_UPLOAD_BYTES=20971520

# --- Security log rotation --------------------------------------------------
# The request log is written for every request (Phase 35), so rotation is not
# optional. These are the sizes the structured sink enforces; size them to the
# traffic and to how long an incident window must remain reconstructable.
ERP_SECURITY_LOG_MAX_SIZE=10485760
ERP_SECURITY_LOG_MAX_FILES=10

# --- Vendored data ----------------------------------------------------------
# Only needed when vendor/ is not at the expected location (frozen builds).
# ERP_VENDOR_DATA_DIR=/srv/dz-erp/vendor

# --- Secrets: never in this file --------------------------------------------
# ERP_VAULT_KEY and ERP_AUDIT_HMAC_SECRET may be supplied by the environment of
# a managed deployment, but they are secrets and belong in the platform's secret
# store, not in a file copied next to a compose file. When they are unset the
# application generates and persists the material beside the vault with
# owner-only permissions (docs/KEY_CUSTODY_THREAT_MODEL.md). Declaring
# ERP_KEY_PROVIDER=kms|hsm without a real provider makes start-up refuse.
